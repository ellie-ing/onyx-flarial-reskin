<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flarial.Launcher.ViewModels"
             xmlns:views="clr-namespace:Flarial.Launcher.Views"
             mc:Ignorable="d"
             Width="519" Height="330"
             x:Class="Flarial.Launcher.Views.SettingsVersionsView"
             x:DataType="vm:SettingsVersionsViewModel"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Visible" IsDeferredScrollingEnabled="True" Background="Transparent">
        <ItemsControl ItemsSource="{Binding Versions}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsEnabled="{Binding !IsInstalling}">

            <ItemsControl.Template>
                <ControlTemplate>
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    Margin="2,0,6,0"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:VersionItemView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
