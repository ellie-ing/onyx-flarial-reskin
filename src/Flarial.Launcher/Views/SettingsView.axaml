<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flarial.Launcher.ViewModels"
             xmlns:types="clr-namespace:Flarial.Launcher.Types"
             xmlns:controls="clr-namespace:Flarial.Launcher.Controls.ToolTip"
             xmlns:gif="using:Avalonia.Labs.Gif"
             xmlns:converters="clr-namespace:Flarial.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Flarial.Launcher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             BorderThickness="{StaticResource ButtonBorderThickness}"
             BorderBrush="{StaticResource BackgroundBorderColor}"
             CornerRadius="25"
             Width="800" Height="500">
    <UserControl.Clip>
        <RectangleGeometry Rect="0,0,800,500"/>
    </UserControl.Clip>
    <UserControl.Styles>
        <!-- return button: same parallelogram chrome as the nav items, as a Button -->
        <Style Selector="Button.ReturnNavButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid>
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="LetterSpacing" Value="1.6"/>
                                </Style>
                            </Grid.Styles>
                            <Path Name="NavOuter" Stretch="Fill" Fill="#66FFFFFF"
                                  Data="M12,0 H100 L88,38 H0 Z"/>
                            <Path Name="NavInner" Stretch="Fill" Margin="1.5,1,1.5,1" Fill="#D6000000"
                                  Data="M11,0 H89 L78,36 H0 Z">
                                <Path.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Fill" Duration="0:0:0.18"/>
                                    </Transitions>
                                </Path.Transitions>
                            </Path>
                            <StackPanel Orientation="Horizontal" Margin="26,0" Spacing="11"
                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border Width="24" Height="24" CornerRadius="2.5" Background="#24FFFFFF">
                                    <ContentControl Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ReturnNavButton:pointerover /template/ Path#NavInner">
            <Setter Property="Fill" Value="#2EFFFFFF"/>
        </Style>

        <!-- sidebar hover slide: the wrap carries the entrance animation's transform,
             so the slide itself is applied to the inner control -->
        <Style Selector="RadioButton.SettingsRadioButton">
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.NavWrap:pointerover RadioButton.SettingsRadioButton">
            <Setter Property="RenderTransform" Value="translateX(7px)"/>
        </Style>
        <Style Selector="Border.NavWrap:pointerover Button.ReturnNavButton">
            <Setter Property="RenderTransform" Value="translateX(7px)"/>
        </Style>

        <!-- entrance: sidebar pieces slide in staggered, panel slides in from the right
             (runs when the code-behind adds the .enter class on navigation to Settings) -->
        <Style Selector="Grid#RootGrid.enter Border#SideTitleWrap">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Backward" Delay="0:0:0.30">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="(TranslateTransform.X)" Value="-30"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid#RootGrid.enter Border#NavGeneralWrap">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Backward" Delay="0:0:0.37">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="(TranslateTransform.X)" Value="-30"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid#RootGrid.enter Border#NavVersionsWrap">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Backward" Delay="0:0:0.44">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="(TranslateTransform.X)" Value="-30"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid#RootGrid.enter Border#SideKanaWrap">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Backward" Delay="0:0:0.51">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="(TranslateTransform.X)" Value="-30"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid#RootGrid.enter Border#ReturnWrap">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Backward" Delay="0:0:0.58">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="(TranslateTransform.X)" Value="-30"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid#RootGrid.enter Grid#PanelWrap">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Easing="CubicEaseOut" FillMode="Backward" Delay="0:0:0.32">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="(TranslateTransform.X)" Value="40"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- panel title: jitter kick + rule draw-in on tab switch (classes toggled from code-behind) -->
        <Style Selector="TextBlock#PageTitle.tj">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="20%">
                        <Setter Property="(TranslateTransform.X)" Value="-6"/>
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="(TranslateTransform.X)" Value="5"/>
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="(TranslateTransform.X)" Value="-2.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="80%">
                        <Setter Property="(TranslateTransform.X)" Value="1.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.X)" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border#TitleRule.draw">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(ScaleTransform.ScaleX)" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(ScaleTransform.ScaleX)" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Name="RootGrid">
        <!-- backdrop: same living background as Home, dimmed harder (the mock's .scrim2) -->
        <Border IsHitTestVisible="False" Name="MainBorder" Background="{StaticResource BackgroundColor}" CornerRadius="25">
            <Grid>
                <gif:GifImage x:Name="BackgroundGif" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="UniformToFill"/>

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#E6000000" Offset="0"/>
                            <GradientStop Color="#B3000000" Offset="0.38"/>
                            <GradientStop Color="#26000000" Offset="0.7"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border>
                    <Border.Background>
                        <RadialGradientBrush Center="55%,50%" GradientOrigin="55%,50%" RadiusX="0.95" RadiusY="0.95">
                            <GradientStop Color="#00000000" Offset="0.55"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- extra dim layer for the options screen -->
                <Border Background="#BD000000"/>

                <Border Width="480" HorizontalAlignment="Left">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" DestinationRect="0,0,6,6">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#21FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="3,3" RadiusX="0.8" RadiusY="0.8"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#FF000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,0.6%" SpreadMethod="Repeat">
                            <GradientStop Color="#0BFFFFFF" Offset="0"/>
                            <GradientStop Color="#0BFFFFFF" Offset="0.33"/>
                            <GradientStop Color="#00000000" Offset="0.34"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Height="133" VerticalAlignment="Top">
                    <Border.RenderTransform>
                        <TranslateTransform Y="-140"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#14FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Styles>
                        <Style Selector="Border">
                            <Style.Animations>
                                <Animation Duration="0:0:7" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="(TranslateTransform.Y)" Value="-140"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="(TranslateTransform.Y)" Value="520"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Border.Styles>
                </Border>
            </Grid>
        </Border>

        <!-- header (same as Home; binds through SettingsViewModel.HomeViewModel) -->
        <Grid Margin="20,14,20,0" VerticalAlignment="Top" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="34" Height="34">
                        <Path Data="M17,2 L29,12 L17,32 L5,12 Z" Fill="White"/>
                        <Path Data="M5,12 H29 M17,2 L12,12 L17,32 L22,12 Z" Stroke="Black" StrokeThickness="1.3"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="ONYX" FontFamily="{StaticResource Unbounded}" FontWeight="Black" FontSize="16" LetterSpacing="5.1" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Border Margin="12,0,0,0" VerticalAlignment="Center" Background="White" Padding="13,3,13,3" RenderTransform="skewX(-18deg)">
                    <TextBlock Text="{Binding HomeViewModel.GameVersion}" Foreground="Black" FontWeight="Bold" FontSize="11" LetterSpacing="0.9" RenderTransform="skewX(18deg)"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding HomeViewModel.LauncherVersion}" FontFamily="{StaticResource MajorMono}" FontSize="11" Foreground="#B3FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           controls:CustomToolTip.Content="Your Minecraft version is unsupported by Flarial"/>
                <Border Background="#8C000000" BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="4" Padding="5,4,13,4">
                    <Grid ColumnDefinitions="Auto,Auto,Auto">
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="3">
                            <Border.Background>
                                <ImageBrush Source="{Binding HomeViewModel.Account.Avatar}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding HomeViewModel.Account.Username, Converter={x:Static converters:UpperCaseConverter.Instance}}" FontWeight="Bold" FontSize="12" LetterSpacing="1.7"
                                   Foreground="{StaticResource ForegroundColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Border Grid.Column="2" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"
                                Background="{Binding HomeViewModel.Account.Entitlement.Background}"
                                BorderBrush="{Binding HomeViewModel.Account.Entitlement.Border}"
                                Padding="6,2,6,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding HomeViewModel.Account.Entitlement.Name}" FontSize="11"
                                       Foreground="{StaticResource ForegroundColor}"/>
                        </Border>
                    </Grid>
                </Border>
                <Button x:Name="MinimizeButton" Classes="MinimizeButton" Margin="10,0,0,0" Command="{Binding HomeViewModel.MinimizeWindow}"/>
                <Button x:Name="CloseButton" Classes="CloseButton" Command="{Binding HomeViewModel.CloseWindow}"/>
            </StackPanel>
        </Grid>

        <!-- sidebar -->
        <Grid Margin="20,70,0,20" Width="177" HorizontalAlignment="Left"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Border Name="SideTitleWrap" Grid.Row="0" Padding="4,4,0,8">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="OPTIONS" FontFamily="{StaticResource Unbounded}" FontWeight="ExtraBold"
                               FontSize="11" LetterSpacing="3" Foreground="White" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#99FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Border Name="NavGeneralWrap" Classes="NavWrap" Grid.Row="1" Margin="0,2,0,0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <RadioButton IsChecked="True" Classes="SettingsRadioButton" Name="GeneralPageButton" GroupName="SettingsNav"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Static types:PageTransitions.SettingsGeneralPage}"
                             Content="GENERAL">
                    <RadioButton.Tag>
                        <Path Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2zM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" Fill="Transparent" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
                    </RadioButton.Tag>
                </RadioButton>
            </Border>

            <Border Name="NavVersionsWrap" Classes="NavWrap" Grid.Row="2" Margin="0,8,0,0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <RadioButton Classes="SettingsRadioButton" Name="VersionsPageButton" GroupName="SettingsNav"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Static types:PageTransitions.SettingsVersionsPage}"
                             Content="VERSIONS">
                    <RadioButton.Tag>
                        <Path Data="M3 17l2 2 4-4M3 7l2 2 4-4M13 6h8M13 12h8M13 18h8" Fill="Transparent" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
                    </RadioButton.Tag>
                </RadioButton>
            </Border>

            <Border Name="SideKanaWrap" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="オ" FontFamily="{StaticResource DelaGothic}" FontSize="23" Foreground="#A6FFFFFF" HorizontalAlignment="Center">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Style.Animations>
                                    <Animation Duration="0:0:3.4" IterationCount="INFINITE" Delay="0:0:0">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="16%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#FFFFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="34%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Text="プ" FontFamily="{StaticResource DelaGothic}" FontSize="23" Foreground="#A6FFFFFF" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Style.Animations>
                                    <Animation Duration="0:0:3.4" IterationCount="INFINITE" Delay="0:0:0.18">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="16%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#FFFFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="34%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Text="シ" FontFamily="{StaticResource DelaGothic}" FontSize="23" Foreground="#A6FFFFFF" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Style.Animations>
                                    <Animation Duration="0:0:3.4" IterationCount="INFINITE" Delay="0:0:0.36">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="16%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#FFFFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="34%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Text="ョ" FontFamily="{StaticResource DelaGothic}" FontSize="23" Foreground="#A6FFFFFF" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Style.Animations>
                                    <Animation Duration="0:0:3.4" IterationCount="INFINITE" Delay="0:0:0.54">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="16%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#FFFFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="34%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Text="ン" FontFamily="{StaticResource DelaGothic}" FontSize="23" Foreground="#A6FFFFFF" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Style.Animations>
                                    <Animation Duration="0:0:3.4" IterationCount="INFINITE" Delay="0:0:0.72">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="16%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#FFFFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="34%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Foreground">
                                                <SolidColorBrush Color="#A6FFFFFF"/>
                                            </Setter>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Name="ReturnWrap" Classes="NavWrap" Grid.Row="5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Button Classes="ReturnNavButton" Command="{Binding NavigateCommand}" CommandParameter="{x:Static types:PageTransitions.HomePage}"
                        Content="RETURN">
                    <Button.Tag>
                        <Path Width="11" Height="11" Stretch="Uniform" Data="M19 12H5M11 6l-6 6 6 6" Stroke="White" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                    </Button.Tag>
                </Button>
            </Border>
        </Grid>

        <!-- panel -->
        <Grid Name="PanelWrap" Margin="217,70,20,20">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            <Path Stretch="Fill" Fill="#9E000000" Stroke="#80FFFFFF" StrokeThickness="1"
                  Data="M0,0 H548 L563,15 V410 H0 Z"/>
            <Grid Margin="22,16,22,14" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0">
                    <TextBlock Name="PageTitle" Text="GENERAL" FontFamily="{StaticResource Unbounded}" FontWeight="Black"
                               FontSize="20" Foreground="White" Height="28" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Border Name="TitleRule" Height="2" Margin="0,10,0,13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>0%,50%</Border.RenderTransformOrigin>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Name="UserControlGrid">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,519,327"/>
                    </Grid.Clip>
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <ContentControl Name="SettingsGeneralViewControl" Content="{Binding SettingsGeneralViewModel}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <ContentControl Name="SettingsVersionsViewControl" Content="{Binding SettingsVersionsViewModel}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform Y="327"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <ContentControl Name="SettingsConfigsViewControl" Content="{Binding SettingsConfigsViewModel}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform Y="654"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
