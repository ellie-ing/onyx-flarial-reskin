<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Flarial.Launcher.ViewModels"
             xmlns:segmentedBar="clr-namespace:Flarial.Launcher.Controls.SegmentedBar"
             xmlns:converters="clr-namespace:Flarial.Launcher.Converters"
             mc:Ignorable="d"
             Width="519" Height="330"
             x:Class="Flarial.Launcher.Views.SettingsGeneralView"
             x:DataType="vm:SettingsGeneralViewModel"
             Background="Transparent">
    <StackPanel Margin="2,0" Spacing="13">

        <!-- ACCOUNT -->
        <StackPanel Spacing="7">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="6" Height="6" Background="White" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock Grid.Column="1" Text="ACCOUNT" FontFamily="{StaticResource Unbounded}" FontWeight="ExtraBold" FontSize="9.5" LetterSpacing="2.2" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#8CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Border Background="#0DFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Height="44" Padding="10,0,8,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="3" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush Source="{Binding Account.Avatar}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Account.Username, Converter={x:Static converters:UpperCaseConverter.Instance}}" FontSize="12" FontWeight="Bold" LetterSpacing="1.2" Foreground="White"/>
                        <TextBlock Text="Signed in" FontSize="9.5" Foreground="#99FFFFFF" IsVisible="{Binding AccountAvailable}"/>
                        <TextBlock Text="Not signed in" FontSize="9.5" Foreground="#99FFFFFF" IsVisible="{Binding !AccountAvailable}"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Button Classes="OnyxButton" Content="LOGOUT" IsVisible="{Binding AccountAvailable}" Command="{Binding Logout}"/>
                        <Button Classes="OnyxButton hi" Content="LOGIN" IsVisible="{Binding !AccountAvailable}" Command="{Binding Login}"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- FOLDERS -->
        <StackPanel Spacing="7">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="6" Height="6" Background="White" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock Grid.Column="1" Text="FOLDERS" FontFamily="{StaticResource Unbounded}" FontWeight="ExtraBold" FontSize="9.5" LetterSpacing="2.2" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#8CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Classes="OnyxButton wide" Command="{Binding OpenClientFolder}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                            <Path Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="OPEN CLIENT FOLDER" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="OnyxButton wide" Command="{Binding OpenLauncherFolder}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                            <Path Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="OPEN LAUNCHER FOLDER" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- LAUNCHER -->
        <StackPanel Spacing="7">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="6" Height="6" Background="White" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock Grid.Column="1" Text="LAUNCHER" FontFamily="{StaticResource Unbounded}" FontWeight="ExtraBold" FontSize="9.5" LetterSpacing="2.2" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#8CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Background="#0DFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Height="40" Padding="12,0,10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Automatic updates" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Classes="OnyxSwitch" IsChecked="{Binding AutomaticUpdates}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#0DFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Height="40" Padding="12,0,10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Performance mode" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Classes="OnyxSwitch" IsChecked="{Binding PerformanceMode}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <!-- CLIENT -->
        <StackPanel Spacing="7">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="6" Height="6" Background="White" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock Grid.Column="1" Text="CLIENT" FontFamily="{StaticResource Unbounded}" FontWeight="ExtraBold" FontSize="9.5" LetterSpacing="2.2" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#8CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel>
                <segmentedBar:SegmentedBar Items="{Binding BuildTypes}" SelectedItem="{Binding SelectedBuild, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding CustomDllSelected}">
                    <TextBox Grid.Column="0" Height="30" VerticalAlignment="Center" IsReadOnly="True" CaretBrush="Transparent"
                             PlaceholderText="Custom DLL Path" Text="{Binding CustomDllPath, Mode=TwoWay}"/>
                    <Button Grid.Column="1" Classes="OnyxButton" Content="Open" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding Open}"/>
                </Grid>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
