<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.LaunchButton">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Name="LaunchRoot" Width="333" Height="55">
                        <Grid.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Grid.Transitions>
                        <Grid>
                        <Grid.Clip>
                            <StreamGeometry>M13,0 H333 L320,55 H0 Z</StreamGeometry>
                        </Grid.Clip>

                        <Path Name="LaunchShape" Stretch="Fill" Fill="{StaticResource PrimaryColor}"
                              Data="M13,0 H333 L320,55 H0 Z"/>

                        <!-- sheen sweep -->
                        <Border IsHitTestVisible="False" HorizontalAlignment="Left" Width="73">
                            <Border.RenderTransform>
                                <TranslateTransform X="-120"/>
                            </Border.RenderTransform>
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Style.Animations>
                                        <Animation Duration="0:0:3.4" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="(TranslateTransform.X)" Value="-120"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="55%">
                                                <Setter Property="(TranslateTransform.X)" Value="430"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="(TranslateTransform.X)" Value="430"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <Border RenderTransform="skewX(-18deg)">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#33000000" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" Margin="25,0,36,0" IsHitTestVisible="False">
                            <TextBlock Grid.Column="0" Name="LaunchText" Text="LAUNCH MINECRAFT"
                                       VerticalAlignment="Center" FontFamily="{StaticResource Unbounded}" FontWeight="ExtraBold"
                                       FontSize="13.5" LetterSpacing="1.4" Foreground="Black"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                <Path Classes="LaunchChev LaunchChev1" Width="12" Height="16" Stretch="Uniform" Data="M5,3 L16,13 L5,23" Stroke="Black" StrokeThickness="4" StrokeLineCap="Square">
                                    <Path.RenderTransform>
                                        <TranslateTransform/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path Classes="LaunchChev LaunchChev2" Width="12" Height="16" Stretch="Uniform" Data="M5,3 L16,13 L5,23" Stroke="Black" StrokeThickness="4" StrokeLineCap="Square">
                                    <Path.RenderTransform>
                                        <TranslateTransform/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path Classes="LaunchChev LaunchChev3" Width="12" Height="16" Stretch="Uniform" Data="M5,3 L16,13 L5,23" Stroke="Black" StrokeThickness="4" StrokeLineCap="Square">
                                    <Path.RenderTransform>
                                        <TranslateTransform/>
                                    </Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)"/>
        </Style>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>

        <Style Selector="^:disabled /template/ Path#LaunchShape">
            <Setter Property="Fill" Value="#FF606060"/>
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#LaunchText">
            <Setter Property="Foreground" Value="#FFA0A0A0"/>
        </Style>
        <Style Selector="^:disabled /template/ Path.LaunchChev">
            <Setter Property="Stroke" Value="#FFA0A0A0"/>
        </Style>
    </Style>

    <!-- chevron chase animation, staggered per chevron -->
    <Style Selector="Button.LaunchButton /template/ Path.LaunchChev1">
        <Style.Animations>
            <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="-6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.LaunchButton /template/ Path.LaunchChev2">
        <Style.Animations>
            <Animation Duration="0:0:1.1" IterationCount="INFINITE" Delay="0:0:0.18" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="-6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.LaunchButton /template/ Path.LaunchChev3">
        <Style.Animations>
            <Animation Duration="0:0:1.1" IterationCount="INFINITE" Delay="0:0:0.36" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="-6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- hover: the chase speeds up (the mock's .launch-wrap:hover .chev) -->
    <Style Selector="Button.LaunchButton:pointerover /template/ Path.LaunchChev1">
        <Style.Animations>
            <Animation Duration="0:0:0.55" IterationCount="INFINITE" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="-6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.LaunchButton:pointerover /template/ Path.LaunchChev2">
        <Style.Animations>
            <Animation Duration="0:0:0.55" IterationCount="INFINITE" Delay="0:0:0.18" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="-6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.LaunchButton:pointerover /template/ Path.LaunchChev3">
        <Style.Animations>
            <Animation Duration="0:0:0.55" IterationCount="INFINITE" Delay="0:0:0.36" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="-6"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="(TranslateTransform.X)" Value="6"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- 3DS-style launch press: the transitions on LaunchRoot animate these setters;
         removing the class transitions everything back, so the button always returns -->
    <Style Selector="Button.LaunchButton /template/ Grid#LaunchRoot">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.LaunchButton.launching /template/ Grid#LaunchRoot">
        <Setter Property="RenderTransform" Value="scale(1.22)"/>
        <Setter Property="Opacity" Value="0"/>
    </Style>
</Styles>
